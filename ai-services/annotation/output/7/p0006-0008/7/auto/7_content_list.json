    {
        "type": "text",
        "text": "• Kasus 1",
        "bbox": [
            166,
            320,
            278,
            339
        ],
        "page_idx": 2
    },
    {
        "type": "text",
        "text": "Pertama-tama perhatikan kasus khusus saat $\\overline { { A C } }$ melalui titik O.   \nIngat bahwa $\\overline { { A C } }$ artinya ruas garis AC.",
        "bbox": [
            201,
            341,
            732,
            393
        ],
        "page_idx": 2
    },
    {
        "type": "image",
        "img_path": "images/e7f7c0418b8c51ae825b722ad1a743daf02bbf01f92e89bdca49f4ff7ec43cbc.jpg",
        "image_caption": [],
        "image_footnote": [],
        "bbox": [
            381,
            402,
            638,
            560
        ],
        "page_idx": 2
    },
    {
        "type": "text",
        "text": "Bukti:",
        "bbox": [
            203,
            564,
            262,
            584
        ],
        "page_idx": 2
    },
    {
        "type": "text",
        "text": "panjang ${ \\overline { { O A } } } = { \\mathrm { p a n j a n g } } { \\overline { { O B } } }$",
        "bbox": [
            201,
            596,
            447,
            621
        ],
        "page_idx": 2
    },
    {
        "type": "text",
        "text": "(jari-jari lingkaran) maka sama kaki.",
        "bbox": [
            517,
            594,
            836,
            635
        ],
        "page_idx": 2
    },
    {
        "type": "text",
        "text": "$\\angle O A B = \\angle$",
        "bbox": [
            201,
            641,
            433,
            663
        ],
        "page_idx": 2
    },
    {
        "type": "text",
        "text": "(karena $\\triangle A O B$ sama kaki)",
        "bbox": [
            519,
            641,
            755,
            662
        ],
        "page_idx": 2
    },
    {
        "type": "text",
        "text": "$\\angle A O B =$ …..(1)",
        "bbox": [
            201,
            667,
            484,
            690
        ],
        "page_idx": 2
    },
    {
        "type": "text",
        "text": "(jumlah sudut dalam $\\triangle A O B$ adalah 180<sup>◦</sup>)",
        "bbox": [
            517,
            667,
            829,
            709
        ],
        "page_idx": 2
    },
    {
        "type": "text",
        "text": "$\\angle A O B =$ …..(2)",
        "bbox": [
            201,
            715,
            484,
            736
        ],
        "page_idx": 2
    },
    {
        "type": "text",
        "text": "$( \\angle A O B$ adalah pelurus $\\angle B O C )$",
        "bbox": [
