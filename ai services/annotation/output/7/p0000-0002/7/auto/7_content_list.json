    {
        "type": "text",
        "text": "Kata Kunci",
        "text_level": 2,
        "bbox": [
            141,
            103,
            310,
            128
        ],
        "page_idx": 1
    },
    {
        "type": "text",
        "text": "Lingkaran, jari-jari, diameter, sudut pusat, sudut keliling, busur lingkaran, garis singgung, tali busur, segiempat tali busur, teorema Thales, teorema Ptolemeus",
        "bbox": [
            139,
            139,
            831,
            180
        ],
        "page_idx": 1
    },
    {
        "type": "text",
        "text": "Peta Konsep",
        "text_level": 2,
        "bbox": [
            141,
            210,
            333,
            238
        ],
        "page_idx": 1
    },
    {
        "type": "image",
        "img_path": "images/c0204e79be5b169bff3757c325a7bfbd7f410e17de5915ca7ff001469a9bcb7c.jpg",
        "image_caption": [],
