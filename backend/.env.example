# python -c "import secrets; print(secrets.token_hex(32))"


APP_NAME="Lydera"
APP_VERSION="1.0.0"
APP_DESCRIPTION="Backend untuk Lydera"
APP_ENV="development"
APP_SECRET_KEY=SECRET_MAS
APP_DEBUG= True

# Server
HOST="0.0.0.0"
PORT="8000"

# Database
DB_ENGINE="postgresql+asyncpg"
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="DB_NAME"
DB_USER="DB_USER"
DB_PASSWORD="DB_PASSWORD"
DB_URL=${DB_ENGINE}://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# JWT
ACCESS_TOKEN_EXPIRE_DAY=1
JWT_ALGORITHM="HS256"
DATABASE_URL=

# Redis
REDIS_URL="redis://localhost:6379/0"

# Chatbot
EMBEDDING_DIM=3072
CHAT_HISTORY_TURNS=10
CHAT_HISTORY_TTL_SECONDS=1800
QUERY_EMBEDDING_CACHE_TTL_SECONDS=604800
RETRIEVAL_CACHE_TTL_SECONDS=3600
