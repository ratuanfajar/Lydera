        "page_idx": 1
    },
    {
        "type": "image",
        "img_path": "images/c22eb95be445f7d3c19335599265fc33190f661888a5dc0873d9a5c28bb58002.jpg",
        "image_caption": [],
        "image_footnote": [
            "sumber: en.wikipedia.org/Wilhelm Meyer (2021)"
        ],
        "bbox": [
            675,
            271,
            831,
            411
        ],
        "page_idx": 1
    },
