    {
        "type": "text",
        "text": "Ayo Bereksplorasi",
        "bbox": [
            238,
            169,
            374,
            186
        ],
        "page_idx": 1
    },
    {
        "type": "image",
        "img_path": "images/818ce45371c7dbaa07391a921b7214fff9a695e684a4aaf9196dc0d13309984e.jpg",
        "image_caption": [],
