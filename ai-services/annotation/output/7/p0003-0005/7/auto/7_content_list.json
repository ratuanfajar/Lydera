            565,
            871
        ],
        "page_idx": 1
    },
    {
        "type": "header",
        "text": "Eksplorasi 2.1",
        "bbox": [
            176,
            109,
            339,
            133
        ],
        "page_idx": 1
    },
    {
        "type": "footer",
        "text": "Bab 2 | Lingkaran",
        "bbox": [
            649,
            915,
